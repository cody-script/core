{
	"name": "@cody-script/engine",
	"version": "0.4.1",
	"description": "CodyScript: a small, sandboxed interpreter for programs written as JSON. Hosts supply the operations; programs supply the logic.",
	"author": "Cody Pope",
	"license": "MIT",
	"keywords": [
		"interpreter",
		"sandbox",
		"json",
		"rules",
		"dsl",
		"expression",
		"cloudflare-workers"
	],
	"homepage": "https://github.com/cody-script/engine#readme",
	"bugs": {
		"url": "https://github.com/cody-script/engine/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cody-script/engine.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schema.json": "./schema.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist", "schema.json"],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"size": "bun build src/index.ts --minify | gzip -c | wc -c",
		"type-check": "tsc --noEmit",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest --run --coverage",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"prepublishOnly": "bun run check && bun run type-check && bun run test && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^3.2.7",
		"ajv": "^8",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	}
}
