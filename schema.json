{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/cody-script/engine/schema.json",
	"title": "CodyScript program",
	"description": "A program is an input: a literal or an input node, usually a block ({ \"do\": [...] }). Every node is an object whose type is its key. The engine's compile() also checks executor ids, nesting depth and finite numbers.",
	"$ref": "#/$defs/input",
	"$defs": {
		"literal": {
			"description": "A bare number, string, boolean or null is its own value. A string is text, never a variable.",
			"type": ["null", "boolean", "number", "string"]
		},
		"input": {
			"anyOf": [
				{ "$ref": "#/$defs/literal" },
				{ "$ref": "#/$defs/val" },
				{ "$ref": "#/$defs/ref" },
				{ "$ref": "#/$defs/op" },
				{ "$ref": "#/$defs/block" }
			]
		},
		"instruction": {
			"anyOf": [
				{ "$ref": "#/$defs/set" },
				{ "$ref": "#/$defs/ret" },
				{ "$ref": "#/$defs/if" },
				{ "$ref": "#/$defs/for" }
			]
		},
		"instructions": {
			"type": "array",
			"items": { "$ref": "#/$defs/instruction" }
		},
		"name": { "type": "string", "minLength": 1 },
		"tag": {
			"description": "An opaque label echoed back in errors.",
			"type": "string"
		},
		"key": { "not": { "enum": ["__proto__", "prototype", "constructor"] } },
		"value": {
			"description": "Any JSON value. Keys __proto__, prototype and constructor are refused.",
			"anyOf": [
				{ "$ref": "#/$defs/literal" },
				{ "type": "array", "items": { "$ref": "#/$defs/value" } },
				{
					"type": "object",
					"propertyNames": { "$ref": "#/$defs/key" },
					"additionalProperties": { "$ref": "#/$defs/value" }
				}
			]
		},
		"val": {
			"description": "A constant of any type; nothing inside it is read as a node. Only needed for objects and arrays.",
			"type": "object",
			"required": ["val"],
			"additionalProperties": false,
			"properties": {
				"val": { "$ref": "#/$defs/value" },
				"tag": { "$ref": "#/$defs/tag" }
			}
		},
		"ref": {
			"description": "Reads a variable.",
			"type": "object",
			"required": ["ref"],
			"additionalProperties": false,
			"properties": {
				"ref": { "$ref": "#/$defs/name" },
				"tag": { "$ref": "#/$defs/tag" }
			}
		},
		"op": {
			"description": "Calls an executor: one key, \"<executor>.<operation>\" (split at the first dot), whose value names the arguments to compute.",
			"type": "object",
			"required": ["op"],
			"additionalProperties": false,
			"properties": {
				"op": {
					"type": "object",
					"minProperties": 1,
					"maxProperties": 1,
					"propertyNames": { "pattern": "^[^.]+\\..+$" },
					"additionalProperties": {
						"description": "Arguments, resolved in order.",
						"type": "object",
						"propertyNames": { "$ref": "#/$defs/key" },
						"additionalProperties": { "$ref": "#/$defs/input" }
					}
				},
				"arg": {
					"description": "A static argument.",
					"$ref": "#/$defs/value"
				},
				"tag": { "$ref": "#/$defs/tag" }
			}
		},
		"block": {
			"description": "Runs instructions in a new scope; its value is what it returns, else null.",
			"type": "object",
			"required": ["do"],
			"additionalProperties": false,
			"properties": {
				"do": { "$ref": "#/$defs/instructions" },
				"tag": { "$ref": "#/$defs/tag" }
			}
		},
		"set": {
			"description": "Assigns one variable in the current scope: { \"set\": { \"<name>\": <input> } }.",
			"type": "object",
			"required": ["set"],
			"additionalProperties": false,
			"properties": {
				"set": {
					"type": "object",
					"minProperties": 1,
					"maxProperties": 1,
					"propertyNames": {
						"allOf": [{ "$ref": "#/$defs/name" }, { "$ref": "#/$defs/key" }]
					},
					"additionalProperties": { "$ref": "#/$defs/input" }
				},
				"tag": { "$ref": "#/$defs/tag" }
			}
		},
		"ret": {
			"description": "Ends the enclosing block with a value.",
			"type": "object",
			"required": ["ret"],
			"additionalProperties": false,
			"properties": {
				"ret": { "$ref": "#/$defs/input" },
				"tag": { "$ref": "#/$defs/tag" }
			}
		},
		"if": {
			"description": "Runs do when the test is truthy, otherwise el.",
			"type": "object",
			"required": ["if", "do"],
			"additionalProperties": false,
			"properties": {
				"if": { "$ref": "#/$defs/input" },
				"do": { "$ref": "#/$defs/instructions" },
				"el": { "$ref": "#/$defs/instructions" },
				"tag": { "$ref": "#/$defs/tag" }
			}
		},
		"for": {
			"description": "Runs do while the test is truthy.",
			"type": "object",
			"required": ["for", "do"],
			"additionalProperties": false,
			"properties": {
				"for": { "$ref": "#/$defs/input" },
				"do": { "$ref": "#/$defs/instructions" },
				"tag": { "$ref": "#/$defs/tag" }
			}
		}
	}
}
